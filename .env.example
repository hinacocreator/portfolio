# ビルド時に渡す環境変数の例。実際の値は .env.local に書く（.env* は git に入りません）。
# どちらも未設定でビルドできます（ルート配信・相対URLになります）。

# サブパス配信のときだけ。先頭 / あり・末尾 / なし。例: /repo-name
# 独自ドメイン運用では設定しない（GitHub Actions では configure-pages が自動で渡します）。
NEXT_PUBLIC_BASE_PATH=

# 公開URL（サブパスを含める・末尾 / なし）。OGP・canonical・JSON-LD の絶対URLに使います。
# 例: https://example.com
NEXT_PUBLIC_SITE_URL=
