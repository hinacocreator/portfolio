# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# env files（公開URLなどはビルド時に環境変数で渡す。.env.example だけ共有する）
.env*
!.env.example

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# typescript
*.tsbuildinfo
next-env.d.ts

# 写真の原本は公開リポジトリに入れない（公開用に変換した public/images/ だけをコミットする）
/_source-photos/

# 制作用の資料（docs/）は公開リポジトリに入れない（手元にだけ残す）
/docs/

# 確認用スクリーンショット（ローカル専用）
/review-screenshots/
